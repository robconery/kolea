// ─────────────────────────────────────────────────────────────────────────────
// 🐦 Kōlea: the wrangler config TEMPLATE, and the only config in the repo.
//
// `wrangler.jsonc` is yours and is gitignored. A fresh clone has none.
//
//   bun scripts/onboard.ts local    writes a local-only wrangler.jsonc from this
//                                   file (enough for `bun run dev` and the tests)
//   bun scripts/onboard.ts render   fills this in from your answers in
//                                   `.onboard/state.json` (`/onboard` runs it)
//
// Edit THIS file when the shape of the config changes. Edit `wrangler.jsonc`
// (or re-run render) when your values change.
//
//   {{KEY}}                      replaced with the value of KEY
//   {{#if KEY}} … {{/if}}        kept only when KEY is set (no nesting)
//
// Resources are named `kolea-*`. The names are arbitrary: nothing outside your
// Cloudflare account sees them, and every command addresses the database by
// its binding (`DB`). An install that already runs under other names keeps
// them in its own wrangler.jsonc.
//
// Secrets never go in here. They are set with
// `bunx wrangler secret put NAME --env production` (locally: `.dev.vars`).
// The optional ones worth knowing about (`.dev.vars.example` lists them all):
//
//   POSTAL_ADDRESS               the mailing address printed in every footer.
//                                CAN-SPAM requires one on commercial mail.
//   MEMBER_SESSION_SECRET        lets readers sign in on the public site, for
//                                members-only and Premium posts. Any long random
//                                string. `bun run setup` makes a local one.
//   AI_KEY_ENCRYPTION_SECRET     lets Settings → AI store your own model key,
//                                encrypted. `bun run setup` makes a local one.
//   MAILGUN_API_KEY              } only when EMAIL_PROVIDER is "mailgun"
//   MAILGUN_WEBHOOK_SIGNING_KEY  }
//   CLOUDFLARE_DNS_API_TOKEN     the "Add to Cloudflare" button on Sending
//                                domains. Zone:Read and DNS:Edit, nothing else.
//
// No feature needs a binding, a queue or a schedule beyond the ones below.
// Importers, outbound webhooks, sending-domain checks and Ghostwriter takes all
// run on the minutely cron, after the mail.
// ─────────────────────────────────────────────────────────────────────────────
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kolea",
	"main": "src/worker.tsx",
	"compatibility_date": "2025-10-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		// `public/robots.txt` disallows all crawling. Listing it here hands the path
		// to the Worker first, so the public site can answer "allow" on its own host.
		"run_worker_first": [
			"/robots.txt"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "kolea",
			"database_id": "{{D1_DATABASE_ID}}",
			// What `bun run dev` and every `--local` command use instead of the id
			// above, so your local data stays put when the real id is filled in.
			"preview_database_id": "kolea-local",
			"migrations_dir": "migrations"
		}
	],
	// MEDIA holds uploaded images. DOWNLOADS holds lead magnets, and is a separate
	// bucket so nothing that serves MEDIA by key can ever hand one out.
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "kolea-media"
		},
		{
			"binding": "DOWNLOADS",
			"bucket_name": "kolea-downloads"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "SEND_QUEUE",
				"queue": "kolea-send"
			}
		],
		"consumers": [
			{
				"queue": "kolea-send",
				"max_batch_size": 100,
				"max_batch_timeout": 5,
				// The consumer sets its own wait before every retry (`core/backoff.ts`):
				// 15s doubling to five minutes, never sooner than the provider asks.
				// Twelve retries are at least twenty minutes, so a rate limit or a
				// database blip of a few seconds cannot dead-letter good mail.
				"max_retries": 12,
				// For the retry the handler never got to schedule (the invocation died).
				// Unset, that retry is immediate and the budget is gone in a second.
				"retry_delay": 30,
				"dead_letter_queue": "kolea-dlq",
				// One batch = one provider request, so this IS the request rate. Unset,
				// Queues scales to 250 consumers and buries Resend's rate limit (10
				// requests a second, shared by the whole team) in 429s. A batch takes
				// about a second end to end, so six consumers stay under it.
				"max_concurrency": 6
			},
			{
				// Nothing sends from here: it marks the message failed, as a row in D1.
				// Same patience as above: past this queue a message is simply gone.
				"queue": "kolea-dlq",
				"max_batch_size": 100,
				"max_batch_timeout": 30,
				"max_retries": 12,
				"retry_delay": 30
			}
		]
	},
	// Workers Logs. Kept for a week at most, so this is for reading what happened
	// today; anything that has to outlive the week is still a row in D1. Like a
	// binding, it is not inherited: it is repeated under `env.production`.
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	// Minutely: sequence ticks and scheduled broadcasts first, then whatever of
	// D1's 1,000 queries is left goes to sending-domain checks, outbound webhook
	// deliveries, one page of a running import and Ghostwriter takes. Daily
	// 09:17 UTC: the Stripe reconciliation. `worker.tsx` matches the second
	// string as DAILY_CRON.
	"triggers": {
		"crons": [
			"*/1 * * * *",
			"17 9 * * *"
		]
	},
	// ── Local development (`bun run dev`) ──────────────────────────────────────
	"vars": {
		// "console" writes mail to the in-app Outbox instead of sending. Keep it.
		"EMAIL_PROVIDER": "console",
		"FROM_EMAIL": "{{FROM_EMAIL}}",
		"FROM_NAME": "{{FROM_NAME}}",
		"PUBLIC_URL": "http://localhost:8787",
		// `*.localhost` resolves to 127.0.0.1, so one `wrangler dev` serves the
		// console on localhost:8787 and the site on site.localhost:8787.
		"SITE_URL": "http://site.localhost:8787",
		"SITE_TITLE": "{{SITE_TITLE}}",
		"SITE_TAGLINE": "{{SITE_TAGLINE}}",
		"SITE_AUTHOR": "{{FROM_NAME}}",
		"SITE_FORM_SLUG": "newsletter",
		// Local only: skips the Cloudflare Access check. Never set in production.
		"DEV_AUTH_BYPASS": "true"
		// Agent sending is a switch in the admin (System > Agents & keys), off by default.
		//
		// Optional, and local only. Uncomment to try a screen without the service
		// behind it (add a comma after the line above). Never set these in production.
		// "AI_PROVIDER": "fake",        // every writing helper answers from a canned reply
		// "DNS_RESOLVER": "fake",       // Sending domains checks an in-memory DNS,
		// "CLOUDFLARE_DNS": "fake"      // and "Add to Cloudflare" writes to it
	},
	// ── Production (`bun run deploy` always passes --env production) ───────────
	"env": {
		"production": {
			// No workers.dev URL: Access can only guard a hostname on your own zone,
			// so a workers.dev route would be an unauthenticated way around it.
			"workers_dev": false,
			"routes": [
				{
					"pattern": "{{ADMIN_HOST}}",
					"custom_domain": true
				}{{#if SITE_HOST}},
				// The public site. ⚠️ Must NOT be covered by the Access app that
				// guards {{ADMIN_HOST}}, or readers get a login page.
				{
					"pattern": "{{SITE_HOST}}",
					"custom_domain": true
				}{{/if}}
			],
			// ⚠️ Environments do NOT inherit bindings. Every one above is repeated here,
			// or production deploys with env.DB === undefined.
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "kolea",
					"database_id": "{{D1_DATABASE_ID}}",
					"migrations_dir": "migrations"
				}
			],
			"r2_buckets": [
				{
					"binding": "MEDIA",
					"bucket_name": "kolea-media"
				},
				{
					"binding": "DOWNLOADS",
					"bucket_name": "kolea-downloads"
				}
			],
			"queues": {
				"producers": [
					{
						"binding": "SEND_QUEUE",
						"queue": "kolea-send"
					}
				],
				"consumers": [
					{
						"queue": "kolea-send",
						"max_batch_size": 100,
						"max_batch_timeout": 5,
						"max_retries": 12,
						"retry_delay": 30,
						"dead_letter_queue": "kolea-dlq",
						"max_concurrency": 6
					},
					{
						"queue": "kolea-dlq",
						"max_batch_size": 100,
						"max_batch_timeout": 30,
						"max_retries": 12,
						"retry_delay": 30
					}
				]
			},
			"observability": {
				"enabled": true,
				"head_sampling_rate": 1
			},
			"triggers": {
				"crons": [
					"*/1 * * * *",
					"17 9 * * *"
				]
			},
			"vars": {
				// "resend" or "mailgun" puts mail on the wire. "console" is the instant
				// kill switch. Mailgun also needs the two vars below and its two secrets.
				"EMAIL_PROVIDER": "{{EMAIL_PROVIDER}}",
				// "MAILGUN_DOMAIN": "mg.example.com",
				// "MAILGUN_REGION": "us",       // or "eu". Must match the Mailgun account.
				"FROM_EMAIL": "{{FROM_EMAIL}}",
				"FROM_NAME": "{{FROM_NAME}}",
				// ⚠️ Baked into every tracking link and image URL at send time. A wrong
				// value ships permanently broken mail. Must match the first route.
				"PUBLIC_URL": "https://{{ADMIN_HOST}}",
				{{#if SITE_HOST}}// Must match the second route exactly: canonical URL, feed, og:url.
				"SITE_URL": "https://{{SITE_HOST}}",
				"SITE_TITLE": "{{SITE_TITLE}}",
				"SITE_TAGLINE": "{{SITE_TAGLINE}}",
				"SITE_AUTHOR": "{{FROM_NAME}}",
				// A `forms.slug`. Onboarding creates this form; renaming it hides the box.
				"SITE_FORM_SLUG": "newsletter",
				{{/if}}// Optional. Where a buyer manages what they own on your storefront. Fills
				// the account_url merge tag in purchase mail. Unset, the tag is empty and
				// the "grab them from your dashboard" line is left out.
				// "ACCOUNT_URL": "https://example.com/account",
				// Optional. Your own subdomain for the open pixel and tracked links, in
				// place of the admin host. Add it as a third custom_domain route above,
				// outside the Access app. ⚠️ Append-only: mail already sent names the host
				// it went out with, so never remove one that has been used. To change it,
				// put the new host first: "links2.example.com,links.example.com".
				// "TRACKING_HOST": "links.example.com",
				"DEV_AUTH_BYPASS": "false",
				// Both required: `web/auth.ts` fails closed and refuses everyone without them.
				"CF_ACCESS_TEAM_DOMAIN": "{{CF_ACCESS_TEAM_DOMAIN}}",
				"CF_ACCESS_AUD": "{{CF_ACCESS_AUD}}"
				// Agent sending is the switch on System > Agents & keys, off by default.
				// Add "MCP_ALLOW_SEND": "false" to force it off whatever the switch says.
			}
		}
	}
}
