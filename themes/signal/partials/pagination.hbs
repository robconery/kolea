{{#match pages ">" 1}}
<nav class="pager" aria-label="Pages">
    {{#if prev}}<a class="pill" href="{{page_url prev}}" rel="prev"><span class="pill-orb" aria-hidden="true">←</span><span>Newer</span></a>{{else}}<span></span>{{/if}}
    <span class="mono">{{page}} / {{pages}}</span>
    {{#if next}}<a class="pill" href="{{page_url next}}" rel="next"><span>Older</span><span class="pill-orb" aria-hidden="true">→</span></a>{{else}}<span></span>{{/if}}
</nav>
{{/match}}
