{{!< default}}
{{#post}}
<article class="feature" style="--hue: {{hue}}">
    <header class="feature-head feature-head--plain">
        <div class="feature-headline">
            <h1 class="feature-title">{{title}}</h1>
        </div>
    </header>
    <div class="feature-body feature-body--solo">
        <div class="copy">{{content}}</div>
    </div>
</article>
{{/post}}
