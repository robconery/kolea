{{!< default}}
{{#is "author"}}
<section class="topic-head" style="--hue: 236">
    <p class="mono reveal">Everything by</p>
    <h1 class="topic-word">{{author.name}}</h1>
</section>
{{else}}
<section class="topic-head{{#is "paged"}} topic-head--quiet{{/is}}" style="--hue: 186">
    <p class="mono reveal">{{#is "paged"}}The archive{{else}}{{plural pagination.total empty="Nothing yet" singular="1 story" plural="% stories"}}{{/is}}</p>
    <h1 class="topic-word">{{#is "paged"}}Page {{pagination.page}}{{else}}Writing{{/is}}</h1>
</section>
{{/is}}

<section class="spread" aria-label="Stories">
    {{#foreach posts}}{{> story}}{{/foreach}}
</section>

{{pagination}}
