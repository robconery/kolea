<!doctype html>
<html lang="{{@site.locale}}" class="motion-{{@custom.motion}}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{meta_title}}</title>
    <link rel="icon" href="/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,200..800&family=Geist+Mono:wght@400;500&family=Literata:ital,opsz,wght@0,7..72,300..700;1,7..72,300..700&display=swap">
    <link rel="stylesheet" href="{{asset "signal.css"}}">
    <script>document.documentElement.classList.add('js');setTimeout(function(){if(!window.__arrived)document.documentElement.classList.add('arrived')},2500)</script>
    {{kolea_head}}
</head>
<body class="{{body_class}}">
    <a class="skip" href="#story">Skip to the story</a>

    <header class="bar">
        <a class="bar-mark" href="/" aria-label="{{@site.title}}, home">
            <span class="bar-glyph" aria-hidden="true"></span>
            <span class="bar-name">{{@site.title}}</span>
        </a>
        <nav class="bar-nav" aria-label="Topics">
            {{#foreach @site.navigation from="2" limit="4"}}
            <a class="{{link_class for=url class="bar-link" activeClass="is-here"}}" href="{{url}}">{{label}}</a>
            {{/foreach}}
        </nav>
        <div class="bar-actions">
            <a class="bar-icon" href="/search" aria-label="Search">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg>
            </a>
            {{#if @site.signup_action}}<a class="pill pill--ink magnetic" href="/subscribe"><span>Subscribe</span><span class="pill-orb" aria-hidden="true">↗</span></a>{{/if}}
        </div>
    </header>

    <main id="story">
        {{{body}}}
    </main>

    <footer class="foot">
        <p class="foot-word" aria-hidden="true">{{@site.title}}</p>
        <div class="foot-row">
            <p>By {{@site.author}}. Every story here went out by email first.</p>
            <p class="foot-links">
                <a href="/feed.xml">RSS</a>
                <a href="/search">Search</a>
                <a href="/subscribe">Subscribe</a>
                <span>&copy; {{date @site.now format="YYYY"}}</span>
            </p>
        </div>
    </footer>

    <script src="{{asset "signal.js"}}" defer></script>
</body>
</html>
