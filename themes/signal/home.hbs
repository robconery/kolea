{{!< default}}
{{!-- The front page: a personal landing page with magazine energy, turned
      down a notch. Cover and byline side by side, the ticker, what I do,
      where to start, a shelf per chosen topic, and notable links.

      The lede, "What I do" and "Notable links" come from `@profile` (the Site
      screen, or Claude via the site_update MCP tool). Empty ones don't render. --}}

<section class="lp-hero">
    <div class="lp-intro">
        <p class="mast-line reveal" style="--d:0">
            <span class="chip chip--live"><span class="chip-dot"></span>{{@site.title}}</span>
            {{#if post_count}}<span class="mono">{{plural post_count empty="" singular="1 story" plural="% stories"}}</span>{{/if}}
        </p>
        <h1 class="lp-title">{{#if @site.description}}{{#foreach (split @site.description separator=" ")}}<span class="mast-w"><span style="--d:{{@index}}">{{this}}</span></span>{{/foreach}}{{else}}{{#foreach (split @site.title separator=" ")}}<span class="mast-w"><span style="--d:{{@index}}">{{this}}</span></span>{{/foreach}}{{/if}}</h1>
        {{#if @profile.lede}}<p class="lp-lede reveal" style="--d:3">{{@profile.lede}}</p>{{/if}}
        {{#if @site.signup_action}}
        <form class="field field--hero reveal" style="--d:4" method="post" action="{{@site.signup_action}}">
            <label class="visually-hidden" for="hero-email">Email address</label>
            <input id="hero-email" type="email" name="email" required placeholder="you@example.com" autocomplete="email">
            <button class="pill pill--ink magnetic" type="submit"><span>Subscribe</span><span class="pill-orb" aria-hidden="true">↗</span></button>
        </form>
        {{/if}}
    </div>

    {{#if @author.short_bio}}

    <aside class="lp-me reveal" style="--d:2; --hue: 284" aria-labelledby="about-title">
        <p class="mono">Who's writing</p>
        <div class="lp-me-top">
            {{#if @author.photo}}<img class="lp-avatar" src="{{@author.photo}}" alt="{{@author.name}}">{{/if}}
            <h2 class="lp-me-name" id="about-title">{{@author.name}}</h2>
        </div>
        {{#if @author.short_bio}}<div class="lp-me-bio">{{@author.short_bio_html}}</div>{{/if}}
        <p class="lp-me-links">
            {{#foreach @author.social}}<a class="chip chip--ink" href="{{url}}" rel="me noopener">{{label}}</a>{{/foreach}}
        </p>
        {{#if @author.url}}<a class="pill pill--ink lp-me-more" href="{{@author.url}}"><span>More about me</span><span class="pill-orb" aria-hidden="true">→</span></a>{{/if}}
    </aside>
    {{/if}}
</section>

{{#if @custom.ticker}}{{> ticker}}{{/if}}

{{#if @profile.what_i_do}}
<section class="section-block" aria-labelledby="do-title">
    <h2 class="block-title" id="do-title">What I do</h2>
    <div class="lp-do">
        {{#foreach @profile.what_i_do}}
        <article class="lp-do-item reveal" style="--d:{{@index}}; --hue: {{#has number="nth:3"}}52{{else}}{{#has number="nth:2"}}284{{else}}186{{/has}}{{/has}}"><p class="mono">0{{@number}}</p><h3>{{title}}</h3>{{#if body}}<p>{{body}}</p>{{/if}}</article>
        {{/foreach}}
    </div>
</section>
{{/if}}

{{#if start_here}}
<section class="section-block" aria-labelledby="start-title">
    <h2 class="block-title" id="start-title">Start here</h2>
    {{#foreach start_here limit="2"}}{{> spread}}{{/foreach}}
</section>
{{/if}}

{{#foreach shelves}}
<section class="section-block shelf" style="--hue: {{tag.hue}}" aria-labelledby="shelf-{{tag.slug}}">
    <div class="shelf-head">
        <h2 class="block-title" id="shelf-{{tag.slug}}"><span class="shelf-swatch"></span>{{tag.name}}</h2>
        <a class="pill" href="{{tag.url}}"><span>{{plural tag.count.posts empty="" singular="1 story" plural="All %"}}</span><span class="pill-orb" aria-hidden="true">→</span></a>
    </div>
    <div class="more-row">{{#foreach posts}}{{> story compact=true}}{{/foreach}}</div>
</section>
{{/foreach}}

{{#unless start_here}}{{#unless shelves}}
<section class="section-block" aria-labelledby="latest-title">
    <h2 class="block-title" id="latest-title">Latest</h2>
    <div class="more-row lp-pad">{{#foreach latest limit="6"}}{{> story compact=true}}{{/foreach}}</div>
</section>
{{/unless}}{{/unless}}

{{#if @profile.links}}
<section class="section-block" aria-labelledby="links-title">
    <h2 class="block-title" id="links-title">Notable links</h2>
    <div class="lp-links">
        {{#foreach @profile.links}}
        <a class="lp-link reveal" style="--d:{{@index}}; --hue: {{#has number="nth:3"}}52{{else}}{{#has number="nth:2"}}284{{else}}186{{/has}}{{/has}}" href="{{url}}" rel="noopener">{{#if kind}}<span class="mono lp-link-kind">{{kind}}</span>{{/if}}<span class="lp-link-title">{{title}}</span>{{#if blurb}}<span class="lp-link-dek">{{blurb}}</span>{{/if}}<span class="lp-link-host mono">{{host}} ↗</span></a>
        {{/foreach}}
    </div>
</section>
{{/if}}

{{#if post_count}}
<p class="everything"><a class="pill pill--ink" href="/writing"><span>Every story</span><span class="pill-orb" aria-hidden="true">→</span></a></p>
{{/if}}

{{> subscribe-block}}
