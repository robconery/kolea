{{!< default}}
{{#post}}
<article class="chapter">
    <header class="chapter-head">
        <p class="chapter-kicker reveal" style="--d:0">
            {{#primary_tag}}<a href="{{url}}">{{name}}</a>{{/primary_tag}}{{^primary_tag}}An essay{{/primary_tag}}
        </p>
        <h1 class="chapter-title" style="view-transition-name: title-{{id}}">{{title}}</h1>
        <p class="chapter-byline reveal" style="--d:2">
            <span>{{primary_author.name}}</span>
            <span class="dot" aria-hidden="true"></span>
            <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMMM YYYY"}}</time>
            <span class="dot" aria-hidden="true"></span>
            <span>{{reading_time minute="A minute" minutes="% minutes"}}</span>
        </p>
    </header>

    {{#if feature_image}}
    <figure class="plate reveal" style="--d:3">
        <img src="{{img_url feature_image size="l"}}" alt="" style="view-transition-name: plate-{{id}}">
        {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
    </figure>
    {{/if}}

    <div class="text">
        {{content}}
    </div>

    <p class="endmark" aria-hidden="true">❧</p>

    <footer class="chapter-foot">
        {{#if tags}}
        <p class="filed">Filed under {{#foreach tags}}<a href="{{url}}">{{name}}</a>{{#unless @last}}, {{/unless}}{{/foreach}}</p>
        {{/if}}
        <p class="share"><a href="{{share_x_url}}" rel="noopener nofollow">Pass it on</a></p>
    </footer>
</article>

<nav class="turn" aria-label="More essays">
    {{#prev_post}}
    <a class="turn-link turn-prev" href="{{url}}">
        <span class="eyebrow">Earlier</span>
        <span class="turn-title">{{title}}</span>
    </a>
    {{/prev_post}}
    {{#next_post}}
    <a class="turn-link turn-next" href="{{url}}">
        <span class="eyebrow">Later</span>
        <span class="turn-title">{{title}}</span>
    </a>
    {{/next_post}}
</nav>
{{/post}}

{{> subscribe-block}}
