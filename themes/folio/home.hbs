{{!< default}}
{{!-- The front page: a personal landing page, set like a book's front matter.
      Title page and author side by side, then what the author does, where to
      start, the subjects, and notable links.

      The lede, "What I do" and "Notable links" come from `@profile` (the Site
      screen, or Claude via the site_update MCP tool). Empty ones don't render. --}}

<section class="lp-hero">
    <div class="lp-intro">
        <p class="eyebrow reveal" style="--d:0">{{@site.title}}{{#if post_count}} · {{plural post_count empty="" singular="1 essay" plural="% essays"}}{{/if}}</p>
        <h1 class="lp-title reveal" style="--d:1">{{#if @site.description}}{{@site.description}}{{else}}{{@site.title}}{{/if}}</h1>
        {{#if @profile.lede}}<p class="lp-lede reveal" style="--d:2">{{@profile.lede}}</p>{{/if}}
        {{#if @site.signup_action}}
        <form class="subscribe-form subscribe-form--hero reveal" style="--d:3" method="post" action="{{@site.signup_action}}">
            <label class="visually-hidden" for="hero-email">Email address</label>
            <input id="hero-email" type="email" name="email" required placeholder="you@example.com" autocomplete="email">
            <button type="submit"><span>Subscribe</span><span class="btn-mark" aria-hidden="true">→</span></button>
        </form>
        <p class="titlepage-note reveal" style="--d:4">No spam. One click stops them.</p>
        {{/if}}
    </div>

    {{#if @author.short_bio}}

    <aside class="lp-me reveal" style="--d:2" aria-labelledby="about-title">
        <p class="eyebrow">About the author</p>
        <div class="lp-me-top">
            {{#if @author.photo}}<img class="lp-avatar" src="{{@author.photo}}" alt="{{@author.name}}">{{/if}}
            <h2 class="lp-me-name" id="about-title">{{@author.name}}</h2>
        </div>
        {{#if @author.short_bio}}<div class="lp-me-bio">{{@author.short_bio_html}}</div>{{/if}}
        <p class="author-links">
            {{#if @author.url}}<a class="textlink" href="{{@author.url}}">The longer story</a>{{/if}}
            {{#foreach @author.social}}<a href="{{url}}" rel="me noopener">{{label}}</a>{{/foreach}}
        </p>
    </aside>
    {{/if}}
</section>

{{#if @profile.what_i_do}}
<section class="lp-section" aria-labelledby="do-title">
    <h2 class="contents-label" id="do-title"><span>What I do</span></h2>
    <div class="lp-do">
        {{#foreach @profile.what_i_do}}
        <article class="lp-do-item reveal" style="--d:{{@index}}">
            <p class="lp-do-no">{{> roman}}</p>
            <h3>{{title}}</h3>
            {{#if body}}<p>{{body}}</p>{{/if}}
        </article>
        {{/foreach}}
    </div>
</section>
{{/if}}

{{#if start_here}}
<section class="lp-section" aria-labelledby="start-title">
    <h2 class="contents-label" id="start-title"><span>Start here</span></h2>
    {{#foreach start_here limit="2"}}{{> spread}}{{/foreach}}
</section>
{{/if}}

{{#foreach shelves}}
<section class="lp-section" aria-labelledby="shelf-{{tag.slug}}">
    <h2 class="contents-label" id="shelf-{{tag.slug}}">
        <span>{{tag.name}}</span>
        <a class="shelf-all" href="{{tag.url}}">{{plural tag.count.posts empty="" singular="The one essay" plural="All % essays"}} →</a>
    </h2>
    <div class="lp-tiles">{{#foreach posts}}{{> tile}}{{/foreach}}</div>
</section>
{{/foreach}}

{{#unless start_here}}{{#unless shelves}}
<section class="lp-section" aria-labelledby="latest-title">
    <h2 class="contents-label" id="latest-title"><span>Latest</span></h2>
    <div class="lp-tiles">{{#foreach latest limit="6"}}{{> tile}}{{/foreach}}</div>
</section>
{{/unless}}{{/unless}}

{{#if @profile.links}}
<section class="lp-section" aria-labelledby="links-title">
    <h2 class="contents-label" id="links-title"><span>Notable links</span></h2>
    <div class="lp-links">
        {{#foreach @profile.links}}
        <a class="lp-link reveal" style="--d:{{@index}}" href="{{url}}" rel="noopener">{{#if kind}}<span class="lp-link-kind">{{kind}}</span>{{/if}}<span class="lp-link-title">{{title}}</span>{{#if blurb}}<span class="lp-link-dek">{{blurb}}</span>{{/if}}<span class="lp-link-host">{{host}} ↗</span></a>
        {{/foreach}}
    </div>
</section>
{{/if}}

{{#if post_count}}
<p class="everything"><a class="textlink" href="/writing">The complete contents: {{plural post_count empty="" singular="one essay" plural="% essays"}}</a></p>
{{/if}}

{{> subscribe-block}}
