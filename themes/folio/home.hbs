{{!< default}}
{{!-- The front page: a personal landing page, set like a book's front matter.
      Title page and author side by side, then what the author does, where to
      start, the subjects, and notable links.

      ⚠️ DEMO: the lede, "What I do" and "Notable links" are placeholder copy
      written into this template. Kōlea has no data for them yet; they move to
      the Site screen when it does. Everything else is real data. --}}

<section class="lp-hero">
    <div class="lp-intro">
        <p class="eyebrow reveal" style="--d:0">{{@site.title}}{{#if post_count}} · {{plural post_count empty="" singular="1 essay" plural="% essays"}}{{/if}}</p>
        <h1 class="lp-title reveal" style="--d:1">{{#if @site.description}}{{@site.description}}{{else}}{{@site.title}}{{/if}}</h1>
        <p class="lp-lede reveal" style="--d:2">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer posuere erat a ante venenatis dapibus, posuere velit aliquet. One letter when there's something worth reading.</p>
        {{#if @site.signup_action}}
        <form class="subscribe-form subscribe-form--hero reveal" style="--d:3" method="post" action="{{@site.signup_action}}">
            <label class="visually-hidden" for="hero-email">Email address</label>
            <input id="hero-email" type="email" name="email" required placeholder="you@example.com" autocomplete="email">
            <button type="submit"><span>Subscribe</span><span class="btn-mark" aria-hidden="true">→</span></button>
        </form>
        <p class="titlepage-note reveal" style="--d:4">No spam. One click stops them.</p>
        {{/if}}
    </div>

    {{#if @author.short_bio}}

    <aside class="lp-me reveal" style="--d:2" aria-labelledby="about-title">
        <p class="eyebrow">About the author</p>
        <div class="lp-me-top">
            {{#if @author.photo}}<img class="lp-avatar" src="{{@author.photo}}" alt="{{@author.name}}">{{/if}}
            <h2 class="lp-me-name" id="about-title">{{@author.name}}</h2>
        </div>
        {{#if @author.short_bio}}<div class="lp-me-bio">{{@author.short_bio_html}}</div>{{/if}}
        <p class="author-links">
            {{#if @author.url}}<a class="textlink" href="{{@author.url}}">The longer story</a>{{/if}}
            {{#foreach @author.social}}<a href="{{url}}" rel="me noopener">{{label}}</a>{{/foreach}}
        </p>
    </aside>
    {{/if}}
</section>

{{!-- DEMO copy --}}
<section class="lp-section" aria-labelledby="do-title">
    <h2 class="contents-label" id="do-title"><span>What I do</span></h2>
    <div class="lp-do">
        <article class="lp-do-item reveal" style="--d:0">
            <p class="lp-do-no">I.</p>
            <h3>Writing</h3>
            <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nulla vitae elit libero, a pharetra augue. Essays on code, business and the long way round.</p>
        </article>
        <article class="lp-do-item reveal" style="--d:1">
            <p class="lp-do-no">II.</p>
            <h3>Teaching</h3>
            <p>Cras mattis consectetur purus sit amet fermentum. Maecenas faucibus mollis interdum. Books and courses for people who learned on the job.</p>
        </article>
        <article class="lp-do-item reveal" style="--d:2">
            <p class="lp-do-no">III.</p>
            <h3>Building</h3>
            <p>Donec ullamcorper nulla non metus auctor fringilla. Aenean lacinia bibendum nulla sed consectetur. Small tools, shipped and maintained.</p>
        </article>
    </div>
</section>

{{#if start_here}}
<section class="lp-section" aria-labelledby="start-title">
    <h2 class="contents-label" id="start-title"><span>Start here</span></h2>
    {{#foreach start_here limit="2"}}{{> spread}}{{/foreach}}
</section>
{{/if}}

{{#foreach shelves}}
<section class="lp-section" aria-labelledby="shelf-{{tag.slug}}">
    <h2 class="contents-label" id="shelf-{{tag.slug}}">
        <span>{{tag.name}}</span>
        <a class="shelf-all" href="{{tag.url}}">{{plural tag.count.posts empty="" singular="The one essay" plural="All % essays"}} →</a>
    </h2>
    <div class="lp-tiles">{{#foreach posts}}{{> tile}}{{/foreach}}</div>
</section>
{{/foreach}}

{{#unless start_here}}{{#unless shelves}}
<section class="lp-section" aria-labelledby="latest-title">
    <h2 class="contents-label" id="latest-title"><span>Latest</span></h2>
    <div class="lp-tiles">{{#foreach latest limit="6"}}{{> tile}}{{/foreach}}</div>
</section>
{{/unless}}{{/unless}}

{{!-- DEMO copy --}}
<section class="lp-section" aria-labelledby="links-title">
    <h2 class="contents-label" id="links-title"><span>Notable links</span></h2>
    <div class="lp-links">
        <a class="lp-link reveal" style="--d:0" href="https://example.com/podcast"><span class="lp-link-kind">Podcast</span><span class="lp-link-title">Lorem Ipsum Radio</span><span class="lp-link-dek">Vestibulum id ligula porta felis euismod semper. Weekly conversations.</span><span class="lp-link-host">example.com/podcast ↗</span></a>
        <a class="lp-link reveal" style="--d:1" href="https://example.com/book"><span class="lp-link-kind">Book</span><span class="lp-link-title">The Dolor Sit Handbook</span><span class="lp-link-dek">Etiam porta sem malesuada magna mollis euismod. The fundamentals you skipped.</span><span class="lp-link-host">example.com/book ↗</span></a>
        <a class="lp-link reveal" style="--d:2" href="https://github.com/example/amet"><span class="lp-link-kind">Open source</span><span class="lp-link-title">amet-cli</span><span class="lp-link-dek">Nullam quis risus eget urna mollis ornare vel eu leo. A small tool that does one thing.</span><span class="lp-link-host">github.com/example/amet ↗</span></a>
        <a class="lp-link reveal" style="--d:3" href="https://example.com/course"><span class="lp-link-kind">Course</span><span class="lp-link-title">Consectetur, From Scratch</span><span class="lp-link-dek">Maecenas sed diam eget risus varius blandit sit amet non magna. Twelve lessons.</span><span class="lp-link-host">example.com/course ↗</span></a>
    </div>
</section>

{{#if post_count}}
<p class="everything"><a class="textlink" href="/writing">The complete contents: {{plural post_count empty="" singular="one essay" plural="% essays"}}</a></p>
{{/if}}

{{> subscribe-block}}
