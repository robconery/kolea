<li class="entry{{#if lead}} entry--lead{{/if}} reveal" style="--d:{{@index}}">
    <a class="entry-link" href="{{url}}">
        <span class="entry-no" aria-hidden="true">{{#if number}}{{number}}{{else}}{{@number}}{{/if}}</span>
        <span class="entry-body">
            {{#primary_tag}}<span class="entry-kicker">{{name}}</span>{{/primary_tag}}
            <span class="entry-title" style="view-transition-name: title-{{id}}">{{title}}</span>
            {{#if excerpt}}<span class="entry-dek">{{excerpt words="34"}}</span>{{/if}}
        </span>
        <span class="entry-meta">
            <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMM YYYY"}}</time>
            <span>{{reading_time minute="1 min" minutes="% min"}}</span>
        </span>
        {{#if lead}}{{#if feature_image}}
        <span class="entry-plate"><img src="{{img_url feature_image size="m"}}" alt="" loading="lazy" style="view-transition-name: plate-{{id}}"></span>
        {{/if}}{{/if}}
    </a>
</li>
