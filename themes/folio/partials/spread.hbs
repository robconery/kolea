<article class="lp-spread{{#if @even}} lp-spread--flip{{/if}} reveal">
    <a class="lp-spread-art" href="{{url}}" tabindex="-1" aria-hidden="true">
        {{#if feature_image}}<img src="{{img_url feature_image size="l"}}" alt="" loading="lazy" style="view-transition-name: plate-{{id}}">{{else}}<span class="lp-spread-blank">❦</span>{{/if}}
    </a>
    <div class="lp-spread-text">
        <p class="entry-kicker">{{#primary_tag}}{{name}} · {{/primary_tag}}{{reading_time minute="1 minute" minutes="% minutes"}}</p>
        <h3 class="lp-spread-title"><a href="{{url}}" style="view-transition-name: title-{{id}}">{{title}}</a></h3>
        {{#if excerpt}}<p class="lp-spread-dek">{{excerpt words="48"}}</p>{{/if}}
        <a class="textlink" href="{{url}}">Read the essay</a>
    </div>
</article>
