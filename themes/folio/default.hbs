<!doctype html>
<html lang="{{@site.locale}}" class="paper-{{@custom.paper}}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{meta_title}}</title>
    <link rel="icon" href="/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,300..800;1,8..60,300..700&display=swap">
    <link rel="stylesheet" href="{{asset "folio.css"}}">
    <script>document.documentElement.classList.add('js');setTimeout(function(){if(!window.__arrived)document.documentElement.classList.add('arrived')},2500)</script>
    {{kolea_head}}
</head>
<body class="{{body_class}}{{#if @custom.drop_caps}} has-initials{{/if}}">
    <a class="skip" href="#text">Skip to the text</a>
    {{#is "post"}}<div class="progress" aria-hidden="true"></div>{{/is}}

    <header class="runhead">
        <a class="imprint" href="/">{{@site.title}}</a>
        <nav class="runnav" aria-label="Topics">
            {{#foreach @site.navigation from="2" limit="5"}}
            <a class="{{link_class for=url class="runnav-link" activeClass="is-here"}}" href="{{url}}">{{label}}</a>
            {{/foreach}}
            <a class="runnav-link" href="/search">Search</a>
        </nav>
    </header>

    <main id="text">
        {{{body}}}
    </main>

    <footer class="colophon">
        <div class="colophon-mark" aria-hidden="true">❦</div>
        <p class="colophon-line">{{@site.title}} is written by {{@site.author}} and set in Source Serif.</p>
        <p class="colophon-line colophon-small">
            <a href="/feed.xml">Feed</a>
            <span aria-hidden="true">·</span>
            <a href="/subscribe">By email</a>
            <span aria-hidden="true">·</span>
            <span>&copy; {{date @site.now format="YYYY"}}</span>
        </p>
    </footer>

    <script src="{{asset "folio.js"}}" defer></script>
</body>
</html>
