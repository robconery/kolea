{{!< default}}
{{#is "author"}}
<header class="section-head">
    <p class="eyebrow">The collected essays of</p>
    <h1 class="section-title">{{author.name}}</h1>
</header>
{{else}}
<header class="section-head{{#is "paged"}} section-head--quiet{{/is}}">
    <p class="eyebrow">{{#is "paged"}}Contents, continued{{else}}Every essay, newest first{{/is}}</p>
    <h1 class="section-title">{{#is "paged"}}Page {{pagination.page}} <em>of {{pagination.pages}}</em>{{else}}The contents{{/is}}</h1>
</header>
{{/is}}

<section class="contents" aria-label="Essays">
    <ol class="toc">
        {{#foreach posts}}{{> entry}}{{/foreach}}
    </ol>
</section>

{{pagination}}
