{{!< default}}
{{#is "home"}}
<header class="masthead">
    <h1>{{@site.title}}</h1>
    {{#if @site.description}}<p class="tagline">{{@site.description}}</p>{{/if}}
</header>
{{/is}}
{{#is "author"}}
<header class="masthead">
    <p class="kicker">Everything by</p>
    <h1>{{author.name}}</h1>
    {{#if author.bio}}<p class="tagline">{{author.bio}}</p>{{/if}}
</header>
{{/is}}

{{#if @custom.show_search}}{{> search-box}}{{/if}}

{{#if posts}}
<div class="cards">
    {{#foreach posts}}{{> card}}{{/foreach}}
</div>
{{else}}
<p class="result-count">Nothing published yet.</p>
{{/if}}

{{pagination}}

{{#is "home"}}{{> subscribe}}{{/is}}
