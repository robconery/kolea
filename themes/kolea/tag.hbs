{{!< default}}
{{#tag}}
<header class="masthead">
    <p class="kicker">Topic</p>
    <h1>{{name}}</h1>
    {{#if description}}<p class="tagline">{{description}}</p>{{/if}}
    <p class="count">{{plural ../pagination.total empty="No posts" singular="% post" plural="% posts"}}</p>
</header>
{{/tag}}

<div class="cards">
    {{#foreach posts}}{{> card}}{{/foreach}}
</div>

{{pagination}}

{{> subscribe}}
