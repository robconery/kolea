{{!< default}}
{{#post}}
<article class="{{post_class}}">
    <header class="post-head">
        <p class="meta">
            {{#primary_tag}}<a href="{{url}}">{{name}}</a> · {{/primary_tag}}
            <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="LL"}}</time>
            · {{reading_time}}
        </p>
        <h1>{{title}}</h1>
    </header>

    {{#if feature_image}}
    <figure class="feature-wrap">
        <img class="feature" src="{{img_url feature_image size="l"}}" alt="{{feature_image_alt}}">
        {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
    </figure>
    {{/if}}

    <div class="prose gh-content">
        {{content}}
    </div>

    <footer class="post-foot">
        {{#if tags}}<p class="chips">{{#foreach tags}}<a class="chip" href="{{url}}">{{name}}</a>{{/foreach}}</p>{{/if}}
        <p class="share"><a href="{{share_x_url}}" rel="noopener nofollow">Post this on X</a></p>
    </footer>
</article>

<nav class="neighbours">
    {{#next_post}}<a class="newer" href="{{url}}"><span>Newer</span>{{title}}</a>{{else}}<span></span>{{/next_post}}
    {{#prev_post}}<a class="older" href="{{url}}"><span>Older</span>{{title}}</a>{{/prev_post}}
</nav>
{{/post}}

{{> subscribe}}
