<a class="card" href="{{url}}">
    {{#if feature_image}}
    <div class="card-img"><img src="{{img_url feature_image size="m"}}" alt="" loading="lazy" decoding="async"></div>
    {{/if}}
    <div class="card-b">
        <p class="card-meta">
            <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="ll"}}</time>
            {{#primary_tag}}<span class="card-tag">{{name}}</span>{{/primary_tag}}
        </p>
        <h2>{{title}}</h2>
        {{#if excerpt}}<p>{{excerpt}}</p>{{/if}}
    </div>
</a>
