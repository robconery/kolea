{{!< default}}
{{#is "author"}}
<section class="band">
    <p class="tag reveal"><span class="tag-dot"></span>Every transmission from</p>
    <h1 class="band-title">{{author.name}}</h1>
</section>
{{else}}
<section class="band{{#is "paged"}} band--quiet{{/is}}">
    {{> wave}}
    <p class="tag reveal"><span class="tag-dot"></span>{{#is "paged"}}Deeper in the archive{{else}}{{plural pagination.total empty="Silent" singular="1 transmission" plural="% transmissions"}}{{/is}}</p>
    <h1 class="band-title" data-echo="{{#is "paged"}}Page {{pagination.page}}{{else}}Archive{{/is}}">{{#is "paged"}}Page {{pagination.page}}{{else}}Archive{{/is}}</h1>
</section>
{{/is}}

<section class="cascade" aria-label="Posts">
    {{#foreach posts}}{{> transmission}}{{/foreach}}
</section>

{{pagination}}
