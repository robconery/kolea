<article class="tile reveal" style="--h: {{hue_cool}}; --d: {{@index}}">
    <a class="tile-link" href="{{url}}">
        {{#if feature_image}}<span class="tile-art"><img src="{{img_url feature_image size="m"}}" alt="" loading="lazy" style="view-transition-name: art-{{id}}"></span>{{else}}<span class="tile-art tile-art--blank">{{> sun-glyph}}</span>{{/if}}
        <span class="tile-body">
            <span class="tile-meta">{{#primary_tag}}<span class="chip">{{name}}</span>{{/primary_tag}}<time class="mono" datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMM D, YYYY"}}</time></span>
            <span class="tile-title" style="view-transition-name: title-{{id}}">{{title}}</span>
            {{#if excerpt}}<span class="tile-dek">{{excerpt words="22"}}</span>{{/if}}
        </span>
    </a>
</article>
