<article class="lp-spread{{#if @even}} lp-spread--flip{{/if}} reveal" style="--h: {{hue_cool}}">
    <a class="lp-spread-art" href="{{url}}" tabindex="-1" aria-hidden="true">
        <span class="shell"><span class="core crt">{{#if feature_image}}<img src="{{img_url feature_image size="l"}}" alt="" loading="lazy" style="view-transition-name: art-{{id}}">{{else}}<span class="lp-spread-blank">{{> sun-glyph}}</span>{{/if}}</span></span>
    </a>
    <div class="lp-spread-text">
        <p class="mono lp-kicker">{{#primary_tag}}{{name}} · {{/primary_tag}}{{reading_time minute="1 min read" minutes="% min read"}}</p>
        <h3 class="lp-spread-title"><a href="{{url}}" style="view-transition-name: title-{{id}}">{{title}}</a></h3>
        {{#if excerpt}}<p class="lp-spread-dek">{{excerpt words="48"}}</p>{{/if}}
        <a class="lp-more" href="{{url}}">Read it <span aria-hidden="true">→</span></a>
    </div>
</article>
