{{!< default}}
{{!-- The front page: a personal landing page. Two columns up top (who this is,
      and the signup / the person), then what they do, where to start, what
      they write about, and where else to find them.

      The lede, "What I do" and "Notable links" come from `@profile` (the Site
      screen, or Claude via the site_update MCP tool). Empty ones don't render. --}}

<section class="lp-hero">
    <div class="lp-hero-grid">
        <div class="lp-intro">
            <p class="tag reveal" style="--d:0"><span class="tag-dot"></span>{{@site.title}} · {{#if post_count}}{{plural post_count empty="" singular="1 essay" plural="% essays"}}{{else}}New{{/if}}</p>
            <h1 class="lp-title reveal" style="--d:1">{{#if @site.description}}{{@site.description}}{{else}}{{@site.title}}{{/if}}</h1>
            {{#if @profile.lede}}<p class="lp-lede reveal" style="--d:2">{{@profile.lede}}</p>{{/if}}
            {{#if @site.signup_action}}
            <form class="dial lp-dial reveal" style="--d:3" method="post" action="{{@site.signup_action}}">
                <label class="visually-hidden" for="hero-email">Email address</label>
                <input id="hero-email" type="email" name="email" required placeholder="you@example.com" autocomplete="email">
                <button class="beam beam--solid magnetic" type="submit"><span>Subscribe</span><span class="beam-orb" aria-hidden="true">↗</span></button>
            </form>
            <p class="lp-fine mono reveal" style="--d:4">No spam · one click to leave</p>
            {{/if}}
        </div>

        {{#if @author.short_bio}}

        <aside class="lp-me reveal" style="--d:2" aria-labelledby="about-title">
            <div class="shell">
                <div class="core lp-me-core">
                    <div class="lp-me-top">
                        {{#if @author.photo}}<div class="lp-avatar"><img src="{{@author.photo}}" alt="{{@author.name}}"></div>{{/if}}
                        <div>
                            <p class="mono lp-kicker">Who's writing</p>
                            <h2 class="lp-me-name" id="about-title">{{@author.name}}</h2>
                        </div>
                    </div>
                    {{#if @author.short_bio}}<div class="lp-me-bio">{{@author.short_bio_html}}</div>{{/if}}
                    <p class="lp-me-links">
                        {{#foreach @author.social}}<a class="chip" href="{{url}}" rel="me noopener" style="--h: {{#if @odd}}292{{else}}206{{/if}}">{{label}}</a>{{/foreach}}
                    </p>
                    {{#if @author.url}}<a class="lp-more" href="{{@author.url}}">More about me <span aria-hidden="true">→</span></a>{{/if}}
                </div>
            </div>
        </aside>
    {{/if}}
    </div>
</section>

{{#if @custom.horizon}}<div class="lp-horizon">{{> horizon}}</div>{{/if}}

{{#if @profile.what_i_do}}
<section class="lp-section" aria-labelledby="do-title">
    <header class="lp-head">
        <p class="tag"><span class="tag-dot"></span>Work</p>
        <h2 class="lp-h2" id="do-title">What I do</h2>
    </header>
    <div class="lp-do">
        {{#foreach @profile.what_i_do}}
        <article class="lp-do-item reveal" style="--d:{{@index}}; --h: {{#has number="nth:3"}}258{{else}}{{#has number="nth:2"}}292{{else}}206{{/has}}{{/has}}">
            {{> icon}}
            <h3>{{title}}</h3>
            {{#if body}}<p>{{body}}</p>{{/if}}
        </article>
        {{/foreach}}
    </div>
</section>
{{/if}}

{{#if start_here}}
<section class="lp-section" aria-labelledby="start-title">
    <header class="lp-head">
        <p class="tag"><span class="tag-dot"></span>Start here</p>
        <h2 class="lp-h2" id="start-title">If you read two things</h2>
    </header>
    {{#foreach start_here limit="2"}}{{> spread}}{{/foreach}}
</section>
{{/if}}

{{#foreach shelves}}
<section class="lp-section" style="--h: {{tag.hue_cool}}" aria-labelledby="shelf-{{tag.slug}}">
    <header class="lp-head lp-head--row">
        <div>
            <p class="tag"><span class="tag-dot"></span>Topic</p>
            <h2 class="lp-h2" id="shelf-{{tag.slug}}">{{tag.name}}</h2>
        </div>
        <a class="lp-more" href="{{tag.url}}">{{plural tag.count.posts empty="" singular="The one essay" plural="All % essays"}} <span aria-hidden="true">→</span></a>
    </header>
    <div class="lp-tiles">{{#foreach posts}}{{> tile}}{{/foreach}}</div>
</section>
{{/foreach}}

{{#unless start_here}}{{#unless shelves}}
<section class="lp-section" aria-labelledby="latest-title">
    <header class="lp-head"><p class="tag"><span class="tag-dot"></span>Latest</p><h2 class="lp-h2" id="latest-title">Recent writing</h2></header>
    <div class="lp-tiles">{{#foreach latest limit="6"}}{{> tile}}{{/foreach}}</div>
</section>
{{/unless}}{{/unless}}

{{#if @profile.links}}
<section class="lp-section" aria-labelledby="links-title">
    <header class="lp-head">
        <p class="tag"><span class="tag-dot"></span>Elsewhere</p>
        <h2 class="lp-h2" id="links-title">Notable links</h2>
    </header>
    <div class="lp-links">
        {{#foreach @profile.links}}
        <a class="lp-link reveal" style="--d:{{@index}}; --h: {{#has number="nth:3"}}258{{else}}{{#has number="nth:2"}}292{{else}}206{{/has}}{{/has}}" href="{{url}}" rel="noopener">
            {{#if kind}}<span class="mono lp-link-kind">{{kind}}</span>{{/if}}
            <span class="lp-link-title">{{title}}</span>
            {{#if blurb}}<span class="lp-link-dek">{{blurb}}</span>{{/if}}
            <span class="lp-link-host mono">{{host}} ↗</span>
        </a>
        {{/foreach}}
    </div>
</section>
{{/if}}

{{#if post_count}}
<p class="lp-all"><a class="beam" href="/writing"><span>Everything I've written</span><span class="beam-orb" aria-hidden="true">→</span></a></p>
{{/if}}

{{> tune-in}}
