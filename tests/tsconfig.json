{
  // The suite needs two type sets at once, which is why it cannot share the
  // Worker's tsconfig: `@cloudflare/workers-types` for the bindings the specs
  // construct (D1Database, R2Bucket, MessageBatch), and `bun-types` for
  // `bun:test` and `bun:sqlite`. Same reasoning as `src/client/tsconfig.json` —
  // one tsconfig per set of ambient globals, never a shared one.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "bun-types"],
    "noEmit": true
  },
  "include": ["**/*.ts", "../src/**/*.ts", "../src/**/*.tsx"],
  "exclude": ["../src/client"]
}
