{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "big-mailer",
	"main": "src/worker.tsx",
	"compatibility_date": "2025-10-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		// Static assets are served ahead of the Worker on EVERY hostname this
		// script answers, and `public/robots.txt` disallows all crawling — right
		// for the admin console, fatal for the public site. Listing the path here
		// hands it to the Worker first, so `web/site.tsx` can answer "allow" on the
		// site host while the console keeps the blanket disallow.
		"run_worker_first": [
			"/robots.txt"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "big-mailer",
			"database_id": "1828a8a7-4b54-48ca-afae-58bd845edc2d",
			"migrations_dir": "migrations"
		}
	],
	// Image uploads. R2 is S3-compatible but the native binding needs no credentials,
	// which is what makes uploads work in `wrangler dev` offline.
	//
	// DOWNLOADS is a separate bucket, not a prefix in MEDIA, on purpose: `/media/:key`
	// hands out anything in MEDIA to anyone holding the key, and lead magnets must
	// never be one routing change away from that handler. They leave only through
	// `/d/:token`, which resolves a grant row first.
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "big-mailer-media"
		},
		{
			"binding": "DOWNLOADS",
			"bucket_name": "big-mailer-downloads"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "SEND_QUEUE",
				"queue": "big-mailer-send"
			}
		],
		"consumers": [
			{
				"queue": "big-mailer-send",
				"max_batch_size": 100,
				"max_batch_timeout": 5,
				"max_retries": 3,
				"dead_letter_queue": "big-mailer-dlq",
				// One batch = one provider request, so this IS our request rate. Left
				// unset, Queues autoscales to 250 concurrent consumers and buries
				// Resend's 10 req/s limit under 429s, which then burn all three retries
				// and dead-letter perfectly good mail. Six concurrent batches of 100 is
				// ~600 emails/sec of headroom while staying under the limit.
				"max_concurrency": 6
			},
			{
				// Nothing sends from here — the handler just marks the message failed so
				// a give-up is a row in D1 instead of a log line that expires in a week.
				"queue": "big-mailer-dlq",
				"max_batch_size": 100,
				"max_batch_timeout": 30,
				"max_retries": 1
			}
		]
	},
	// Minutely: sequence ticks and scheduled broadcasts. Daily at 09:17 UTC: the
	// Stripe reconciliation. `worker.tsx` switches on `controller.cron`, so the
	// second string here has to stay in sync with `DAILY_CRON` there.
	"triggers": {
		"crons": [
			"*/1 * * * *",
			"17 9 * * *"
		]
	},
	"vars": {
		// "console" writes mail to the in-app Outbox instead of sending. Local default.
		"EMAIL_PROVIDER": "console",
		"FROM_EMAIL": "rob@example.com",
		"FROM_NAME": "Rob Conery",
		"PUBLIC_URL": "http://localhost:8787",
		// The public site is dispatched by hostname (see `worker.tsx`). `*.localhost`
		// resolves to 127.0.0.1, so this one `wrangler dev` serves the console on
		// localhost:8787 and the blog on site.localhost:8787.
		"SITE_URL": "http://site.localhost:8787",
		"SITE_TITLE": "Big Machine",
		"SITE_TAGLINE": "Essays on code, business and the long way round.",
		"SITE_AUTHOR": "Rob Conery",
		// The signup form the site's subscribe box posts to. It posts to the ADMIN
		// host (`PUBLIC_URL`/f/<slug>), which is where the form endpoint lives, so
		// consent arrives by exactly the same path as a signup from anywhere else.
		"SITE_FORM_SLUG": "newsletter",
		// Local only: bypasses the Cloudflare Access check. Never set in production.
		"DEV_AUTH_BYPASS": "true",
		// Locally the provider is "console", so an MCP send lands in the Outbox
		// rather than in anyone's inbox — safe to leave on for development.
		"MCP_ALLOW_SEND": "true"
	},
	// `wrangler deploy --env production` turns the bypass off and takes the admin
	// console back behind Cloudflare Access. The top-level vars above are dev-only;
	// deploying without this env would publish an unauthenticated admin console.
	"env": {
		"production": {
			// No workers.dev URL. Cloudflare Access can only protect a hostname on a
			// zone you control, so leaving the *.workers.dev route enabled would
			// publish an unauthenticated way around it straight to the origin.
			"workers_dev": false,
			"routes": [
				{
					"pattern": "list.bigmachine.io",
					"custom_domain": true
				},
				// The public site. A second custom domain on the same Worker —
				// `worker.tsx` splits them by hostname. ⚠️ This hostname must NOT be
				// covered by the Cloudflare Access application that guards
				// list.bigmachine.io, or readers get a login page.
				{
					"pattern": "a.bigmachine.io",
					"custom_domain": true
				}
			],
			// ⚠️ Wrangler environments do NOT inherit bindings from the top level —
			// every binding above must be repeated here or production deploys without
			// a database, bucket, or queues (env.DB === undefined at runtime).
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "big-mailer",
					"database_id": "1828a8a7-4b54-48ca-afae-58bd845edc2d",
					"migrations_dir": "migrations"
				}
			],
			"r2_buckets": [
				{
					"binding": "MEDIA",
					"bucket_name": "big-mailer-media"
				},
				{
					"binding": "DOWNLOADS",
					"bucket_name": "big-mailer-downloads"
				}
			],
			"queues": {
				"producers": [
					{
						"binding": "SEND_QUEUE",
						"queue": "big-mailer-send"
					}
				],
				"consumers": [
					{
						"queue": "big-mailer-send",
						"max_batch_size": 100,
						"max_batch_timeout": 5,
						"max_retries": 3,
						"dead_letter_queue": "big-mailer-dlq",
						"max_concurrency": 6
					},
					{
						"queue": "big-mailer-dlq",
						"max_batch_size": 100,
						"max_batch_timeout": 30,
						"max_retries": 1
					}
				]
			},
			"triggers": {
				"crons": [
					"*/1 * * * *",
					"17 9 * * *"
				]
			},
			"vars": {
				// Live: mail goes out through Resend. Flip back to "console" to render
				// into the Outbox instead — that's the instant kill switch.
				"EMAIL_PROVIDER": "resend",
				"FROM_EMAIL": "rob@bigmachine.io",
				"FROM_NAME": "Rob Conery",
				// Baked into tracking links and image URLs at send time — a wrong value
				// ships permanently broken email. Must match the route above.
				"PUBLIC_URL": "https://list.bigmachine.io",
				// Must match the second route above exactly: it is the canonical URL,
				// the feed's self link and every og:url on the site.
				"SITE_URL": "https://a.bigmachine.io",
				"SITE_TITLE": "Big Machine",
				"SITE_TAGLINE": "Essays on code, business and the long way round.",
				"SITE_AUTHOR": "Rob Conery",
				// forms.slug = 'newsletter' ("General Signup"), which enrols into the
				// welcome sequence. Renaming that form's slug silently breaks the box.
				"SITE_FORM_SLUG": "newsletter",
				"DEV_AUTH_BYPASS": "false",
				// Admin console identity. Both are required: `web/auth.ts` fails closed
				// and refuses everyone if either is missing.
				"CF_ACCESS_TEAM_DOMAIN": "bigmachine.cloudflareaccess.com",
				"CF_ACCESS_AUD": "c9e5e713caf22211b5575bbf43294596c7677c642821925936954e275fcb9824",
				// Off by default: MCP can read and draft everything, but cannot put
				// mail on the wire until this is "true". A var, not a secret.
				"MCP_ALLOW_SEND": "false"
			}
		}
	}
}