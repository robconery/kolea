# Your own wrangler config. The repo ships wrangler.template.jsonc only;
# `bun run setup` or /onboard writes this file, and it holds your account's ids.
wrangler.jsonc

# wrangler local state + local secrets
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example

# Playwright: run artefacts only. `playwright.config.ts` and `tests/` are
# checked in; the browser state under .wrangler/ui-test-state is covered by the
# .wrangler/ rule above.
test-results/
playwright-report/
blob-report/
.playwright/

# client bundle build output
public/editor.js
public/editor.css
public/charts.js
public/*.js.map

# Screenshot scratch state lives under .wrangler/ (above). The pictures
# themselves, docs/img/*.png, are tracked.

# Design-lint cache and per-machine overrides. .impeccable/config.json is shared.
.impeccable/hook.cache.json
.impeccable/config.local.json

# Personal agent config and notes: kept local, not published
.claude/settings.json
.cursor/
to-do.md
.cf-token

# Scratch folders written by an operator's own import and backfill scripts.
# They can hold real subscriber data.
.import-kit/
.import-kit-content/
.publish-archive/
.import-neon/
.seed-production-store/

# /onboard answers and secrets (secrets.env is 0600)
.onboard/
