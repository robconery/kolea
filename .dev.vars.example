# Kōlea — local secrets.
#
# Copy to `.dev.vars`. Everything here is a secret — `.dev.vars` is gitignored,
# this example file is not, so never paste a real value below.
#
# All of it is optional. With no `.dev.vars` at all, Kōlea runs in console mode
# with MCP and Stripe switched off, and mails nobody.
#
# In production these go in Cloudflare, not here:
#   bunx wrangler secret put NAME --env production

# ── Mail ────────────────────────────────────────────────────────────────────
# Leave EMAIL_PROVIDER=console (the default in wrangler.jsonc) to keep everything
# in the in-app Outbox instead of sending for real.
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Point Resend's webhook at /webhooks/resend. Without it, bounces and complaints
# never suppress, and your sending reputation degrades silently.
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# The one address a "send preview" may ever reach. Defaults to FROM_EMAIL,
# which is your own mailbox by definition.
PREVIEW_EMAIL=you@example.com

# ── MCP ─────────────────────────────────────────────────────────────────────
# The unguessable path segment the MCP server answers on: POST /mcp/<secret>.
# Unset means the endpoint 404s, so MCP is off until you set this.
# Generate one: openssl rand -hex 24
MCP_PATH_SECRET=set-me-to-something-random

# ── Stripe ──────────────────────────────────────────────────────────────────
# Restricted key, read-only on charges / refunds / customers / products / prices.
# Used by the daily reconciliation cron and the stripe_* MCP tools.
STRIPE_SECRET_KEY=rk_test_xxxxxxxxxxxx
# From the Stripe dashboard endpoint pointed at /webhooks/stripe. Without it that
# endpoint fails closed with a 503 — an endpoint that accepts unsigned bodies is
# an endpoint anybody can post fake revenue to.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ── Unsplash ────────────────────────────────────────────────────────────────
# Stock photos for a post's featured image, searched from the publishing screen.
# The "Access Key" of an app at https://unsplash.com/oauth/applications — the
# demo tier's 50 requests/hour is plenty for one person picking pictures.
# Unset just hides the picker; uploading your own image still works.
UNSPLASH_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Writing help (OpenRouter) ───────────────────────────────────────────────
# Subject suggestions, "Clean this up" and sequence drafts in the composer.
# A key from https://openrouter.ai/settings/keys. Give the key a credit limit
# there too. Unset hides every AI button; nothing in core/ai/ is ever called.
OPENROUTER_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional. Hard monthly ceiling in US dollars, counted from the ai_calls table.
# AI_MONTHLY_BUDGET_USD=10
# Optional. OpenRouter model ids per job. Defaults: Sonnet 5 for subjects,
# Opus 5.5 for clean-up and sequence drafts.
# AI_MODEL_SUBJECT=anthropic/claude-sonnet-5
# AI_MODEL_CLEANUP=anthropic/claude-opus-5.5
# AI_MODEL_SEQUENCE=anthropic/claude-opus-5.5
